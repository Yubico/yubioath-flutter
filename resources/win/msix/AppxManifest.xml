<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap desktop6 rescap">

  <!-- Version and architecture are set by CI (build-msix jobs). -->
  <Identity
    Name="YubicoAB.YubicoAuthenticator"
    Publisher="CN=3E612EC1-46FB-46C1-ADB7-25B13FB02B10"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCH$" />

  <Properties>
    <DisplayName>Yubico Authenticator</DisplayName>
    <PublisherDisplayName>Yubico AB</PublisherDisplayName>
    <Description>Yubico Authenticator</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="packagedServices" />
    <rescap:Capability Name="localSystemServices" />
  </Capabilities>

  <Applications>
    <Application Id="AUTHENTICATOR" Executable="authenticator.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        BackgroundColor="transparent"
        DisplayName="Yubico Authenticator"
        Description="Yubico Authenticator"
        Square150x150Logo="Assets\AUTHENTICATOR-Square150x150Logo.png"
        Square44x44Logo="Assets\AUTHENTICATOR-Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\AUTHENTICATOR-Wide310x150Logo.png"
          Square310x310Logo="Assets\AUTHENTICATOR-Square310x310Logo.png"
          Square71x71Logo="Assets\AUTHENTICATOR-Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <desktop6:Extension Category="windows.service"
                            Executable="ykman-svc.exe"
                            EntryPoint="Windows.FullTrustApplication">
          <desktop6:Service Name="yubico-authenticator-svc"
                            StartupType="auto"
                            StartAccount="localSystem"
                            Arguments="run --authenticator-msix" />
        </desktop6:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
